{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@authmodules/contracts": ["../contracts/src/index.d.ts"],
      "@authmodules/contracts/*": ["../contracts/src/*.d.ts"]
    },
    "noUnusedLocals": true,
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "skipLibCheck": true,
    "noEmitOnError": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ]
}
