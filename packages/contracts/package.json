{
  "name": "@authmodules/contracts",
  "version": "0.1.0",
  "description": "Framework-neutral TypeScript contracts for modular authentication and identity systems.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "packageManager": "npm@11.16.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.16.0",
      "onFail": "error"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "lint": "tsc -p tsconfig.json",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts",
    "check": "npm run lint && npm test && npm run build && npm run api:check && npm run package:check && npm run pack:dry-run",
    "prepack": "npm run build",
    "api:update": "npm run build && node ../../scripts/check-package-api.js --write",
    "api:check": "node ../../scripts/check-package-api.js",
    "package:check": "publint && attw --pack --profile esm-only ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.0.0",
    "publint": "^0.3.22",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts"
    },
    "./result": {
      "types": "./src/result.d.ts"
    },
    "./primitives": {
      "types": "./src/primitives.d.ts"
    },
    "./transaction": {
      "types": "./src/transaction.d.ts"
    },
    "./security": {
      "types": "./src/security.d.ts"
    },
    "./errors": {
      "types": "./src/errors.d.ts"
    },
    "./crypto": {
      "types": "./src/crypto.d.ts"
    },
    "./material": {
      "types": "./src/material.d.ts"
    },
    "./method": {
      "types": "./src/method.d.ts"
    },
    "./views": {
      "types": "./src/views.d.ts"
    },
    "./core": {
      "types": "./src/core.d.ts"
    },
    "./store": {
      "types": "./src/store.d.ts"
    },
    "./token": {
      "types": "./src/token.d.ts"
    },
    "./carrier": {
      "types": "./src/carrier.d.ts"
    },
    "./delivery": {
      "types": "./src/delivery.d.ts"
    },
    "./effects": {
      "types": "./src/effects.d.ts"
    },
    "./observability": {
      "types": "./src/observability.d.ts"
    },
    "./guard": {
      "types": "./src/guard.d.ts"
    },
    "./extensions": {
      "types": "./src/extensions.d.ts"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "authmodules",
    "authentication",
    "identity",
    "contracts",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/authmodules/authmodules.git",
    "directory": "packages/contracts"
  },
  "bugs": {
    "url": "https://github.com/authmodules/authmodules/issues"
  },
  "homepage": "https://github.com/authmodules/authmodules/tree/main/packages/contracts#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "types": "./src/index.d.ts"
}
